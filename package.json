{
  "name": "weave-it-org",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/prune-dist.mjs && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "test": "npm run test:unit && npm run build && node --test \"tests/*.test.mjs\"",
    "test:unit": "node --import tsx --test \"tests/unit/*.test.mjs\"",
    "test:content": "node --test \"tests/content/*.test.mjs\"",
    "test:quick": "npm run test:unit && node --test \"tests/{build,urls}.test.mjs\"",
    "test:all": "npm test && npm run test:content",
    "redirects": "tsx scripts/build-redirects.ts",
    "check:urls": "node scripts/check-redirects.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "import:wordpress": "tsx scripts/import-wordpress.ts",
    "sync": "npm run sync:notion",
    "sync:notion": "npm run sync:posts && npm run sync:talks && npm run sync:training && npm run sync:learning-journeys",
    "sync:posts": "tsx scripts/sync-notion.ts content --collection=posts --write",
    "sync:talks": "tsx scripts/sync-notion.ts content --collection=talks --write",
    "sync:training": "tsx scripts/sync-notion.ts content --collection=training --write",
    "sync:learning-journeys": "tsx scripts/sync-notion.ts content --collection=learning-journeys --write"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/share": "^5.3.0",
    "@notionhq/client": "^5.23.2",
    "astro": "^7.1.5",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.1.2",
    "axe-core": "^4.12.1",
    "pagefind": "^1.5.2",
    "playwright": "^1.62.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}
