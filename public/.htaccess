# Generated by scripts/build-redirects.ts — do not edit by hand.
# The URL contract: 147 addresses, each served, redirected once, or Gone.
# The inventory is data/live-urls.txt. See docs/urls.md.

ErrorDocument 404 /404.html
ErrorDocument 410 /410/

<IfModule mod_mime.c>
AddType text/markdown .md
AddCharset UTF-8 .md
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On

# --- 0. One hostname -----------------------------------------------
RewriteCond %{HTTP_HOST} ^www\.weave-it\.org$ [NC]
RewriteRule ^(.*)$ https://weave-it.org/$1 [R=301,L]

# --- 1. Feeds ------------------------------------------------------
RewriteRule ^feed/?$ /rss.xml [R=301,L]
RewriteRule ^(blog|talks|training)/feed/?$ /rss.xml [R=301,L]
RewriteRule ^comments/feed/?$ /rss.xml [R=301,L]

# --- 2. Pagination -------------------------------------------------
RewriteRule ^page/[0-9]+/?$ / [R=301,L]
RewriteRule ^(blog|talks|training)/page/[0-9]+/?$ /$1/ [R=301,L]

# --- 3. Category archives ------------------------------------------
RewriteRule ^category/blog/?$ /blog/ [R=301,L]
RewriteRule ^category/talks/?$ /talks/ [R=301,L]
# Any other category archive was never a page anyone linked to.
RewriteRule ^category/ - [G,L]

# --- 4. Tag archives → the filtered index --------------------------
RewriteRule ^tag/([^/]+)/?$ /blog/?tag=$1 [R=301,L,QSA]

# --- 5. Author archives — Gone -------------------------------------
RewriteRule ^author/ - [G,L]

# --- 6. The `project` custom post type -----------------------------
RewriteRule ^project/facilitating-collaborative-design-decisions/?$ /talks/facilitating-collaborative-design-decisions/ [R=301,L]
RewriteRule ^project/?$ /talks/ [R=301,L]

# --- 7. WordPress machinery — Gone ---------------------------------
RewriteRule ^wp-json - [G,L]
RewriteRule ^wp-content/plugins - [G,L]
RewriteRule ^xmlrpc\.php - [G,L]
RewriteRule ^wp-login\.php - [G,L]
# wp-content/uploads is deliberately absent: the parked WordPress
# directory still serves the media those addresses point at, and things
# outside this repository still reference them. See docs/operations.md.

# --- 10. Retired slugs (editorial merges and renames) --------------
# Content that moved after the URL inventory was taken: the old address
# keeps working. The hand-written ones first, then whatever the sync
# recorded when a slug changed or a page was retired in Notion.
</IfModule>
