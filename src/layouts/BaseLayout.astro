---
/**
 * The one layout. Header, footer, head, structured data.
 *
 * Everything that appears on every page is here rather than repeated, and the
 * navigation is generated from `site.config.ts` so adding a section is one
 * edit. A page passes what is *about that page*; it never re-declares the site.
 */
import '@fontsource/share/400.css';
import '@fontsource/share/700.css';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/600.css';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/patterns.css';
import { PRODUCTION_URL, site } from '../../site.config.ts';
import { breadcrumbs, crumbsFor, graph, organization, pageTitle, person, website } from '../lib/seo.ts';

interface Props {
  title: string;
  description: string;
  /** Index pages keep the brand suffix; detail pages spend the characters on topic. */
  suffix?: boolean;
  /** Extra structured-data nodes for what this page *is*. */
  jsonLd?: (object | null)[];
  /** Kept out of search engines, and out of the site's own index with it. */
  noindex?: boolean;
  /** The markdown twin of this page, advertised to anything reading without HTML. */
  markdown?: string;
}

const { title, description, suffix = false, jsonLd = [], noindex = false, markdown } = Astro.props;

// Staging is never indexable, whatever the page asked for. It serves drafts and
// duplicates production, and `robots.txt` alone does not settle it: that file
// asks a crawler not to fetch a URL, and a URL it already knows about can still
// be listed without being fetched. This is the half that says "do not list it".
const hideFromSearch = noindex || site.isStaging;

const path = Astro.url.pathname;
const canonical = new URL(path, site.url).toString();
const crumbs = crumbsFor(path);

const data = graph(
  website(),
  organization(),
  person(),
  breadcrumbs(crumbs),
  ...jsonLd,
);
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle(title, { suffix })}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {hideFromSearch && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={site.locale.replace('-', '_')} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}

    {/* Both of these pointed at files that were never added, so every page on
        the site fetched two 404s. `build.test.mjs` found it by resolving every
        internal link against `dist/` — which is the whole argument for that
        test: nothing about a missing favicon is visible while developing.

        PNG rather than ICO. The source is a 512px PNG, sharp cannot write ICO,
        and a declared `rel="icon"` is what browsers use — the bare
        `/favicon.ico` request only happens when no icon is declared at all. */}
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* is:inline because this is data, not code: Astro must not try to bundle
        it. `astro check` is kept at 0 errors / 0 warnings / 0 hints, and this
        is the directive that earns the last zero. */}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />

    {
      /* Repository *variables*, not secrets: both values are visible in the page
         source anyway, so hiding them would only make them harder to change.
         Unset means no tag at all, which is what a local build and a fork get. */
      site.analytics.src && (
        <script
          is:inline
          defer
          src={site.analytics.src}
          data-domain={site.analytics.domain}
        />
      )
    }
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    {
      /* Says out loud what the URL only implies. Staging carries unpublished
         drafts, so anyone landing here from a shared link — or from a search
         result that predates the noindex — needs to know that what they are
         reading is not published and may never be. */
      site.isStaging && (
        <p class="staging-banner" data-test="staging-banner">
          <strong>Staging.</strong> This is a preview of the new site and includes
          unpublished drafts. The live site is <a href={PRODUCTION_URL}>weave-it.org</a>.
        </p>
      )
    }

    {/* The teal utility strip above the header. Social links only — it exists
        to put the brand colour at the very top of the page, and the icons are
        what it has to carry. */}
    <div class="utility-bar">
      <div class="wrap utility-inner">
        <ul class="utility-links">
          {
            site.author.links.map((l) => (
              <li>
                <a href={l.url} rel="me">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/" aria-label={`${site.name} — home`}>
          {/* The wordmark carries the name, so the link's own label says it
              instead and the image is decorative. Announcing both reads the
              brand twice. */}
          <img src="/logo-weaveit.png" alt="" width="200" height="149" />
        </a>
        {/* Hidden in the markup and revealed by the script, so a reader without
            JavaScript never meets a button that does nothing. The nav below is
            a plain list until something collapses it — see the script. */}
        <button
          class="nav-toggle js-nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="site-nav"
          hidden
        >
          <span class="nav-toggle__bars" aria-hidden="true"></span>
          Menu
        </button>

        <nav aria-label="Main">
          <ul id="site-nav">
            <li>
              <a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a>
            </li>
            {
              site.sections
                .filter((s) => s.inNav)
                .map((s) => (
                  <li>
                    <a
                      href={`/${s.path}/`}
                      aria-current={path.startsWith(`/${s.path}/`) ? 'page' : undefined}
                    >
                      {s.label}
                    </a>
                  </li>
                ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <img class="footer-logo" src="/logo-weaveit-white.png" alt="" width="180" height="134" />

        <div class="footer-right">
          <ul class="footer-links" data-test="footer-socials">
            <li><a href="/">Home</a></li>
            {
              site.sections
                .filter((s) => s.inNav)
                .map((s) => (
                  <li>
                    <a href={`/${s.path}/`}>{s.label}</a>
                  </li>
                ))
            }
          </ul>

          <ul class="footer-links footer-links--social">
            {
              site.author.links.map((l) => (
                <li>
                  {/* `rel="me"` is what lets a Mastodon profile verify that this
                      site is the same person. It only works from a link the
                      profile also points back at. */}
                  <a href={l.url} rel="me">
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>

          <p class="muted">
            {/* Explicit spacing: JSX drops the whitespace at a line break, and
                this read "Codeon GitHub". */}
            © {new Date().getFullYear()} {site.name}. Brand and web design by Art of Design.
            Code{' '}
            <a href="https://github.com/Baasie/weave-it.org">on GitHub</a>.
          </p>
        </div>
      </div>
    </footer>

    <style>
      /* Olive fill, ink text. Never white on this — it measures 2.37:1 and a
         warning nobody can read is not a warning. See tokens.css. */
      .staging-banner {
        margin: 0;
        padding: var(--space-3) var(--space-5);
        background: var(--color-accent);
        color: var(--on-brand);
        font-size: var(--text-sm);
        text-align: center;
      }
      .staging-banner a {
        color: var(--on-brand);
      }
      /* The teal strip above everything. */
      .utility-bar {
        background: var(--color-primary);
      }
      .utility-inner {
        display: flex;
        justify-content: flex-end;
        padding-block: var(--space-2);
      }
      .utility-links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-5);
        list-style: none;
        margin: 0;
        padding: 0;
        font-size: var(--text-sm);
      }
      .utility-links a {
        color: var(--on-colour); /* 4.64:1 on the teal */
      }

      /* The header is the same sage as the page: no border, because the teal
         strip above it is the edge. */
      .site-header {
        background: var(--color-bg);
      }
      .header-inner {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-4) var(--space-8);
        align-items: center;
        justify-content: space-between;
        padding-block: var(--space-3);
      }
      .brand img {
        width: 150px;
        height: auto;
      }
      nav ul {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-6);
        list-style: none;
        margin: 0;
        padding: 0;
      }
      /* Uppercase, letter-spaced Poppins — measured off the live nav. */
      nav a {
        font-size: 0.9375rem;
        font-weight: 500;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: var(--color-heading);
      }
      /* The live site marks the current page with the brand green, which is
         2.11:1 on the sage — colour alone, and unreadable colour at that. The
         darker green carries the text and the underline does the marking, so
         it does not depend on seeing the hue at all. */
      nav a[aria-current='page'] {
        color: var(--color-moss-ink);
        border-bottom: 2px solid var(--color-moss-ink);
      }

      /* The menu button ------------------------------------------------
       *
       * Seven nav items wrapped to three lines on a 360px phone: a 286px
       * header on an 800px viewport, with the page starting 52% of the way
       * down. This collapses it.
       *
       * **The collapse is the enhancement, not the nav.** The markup is a
       * plain list; the script adds `data-nav` and only then does any of the
       * CSS below apply. With JavaScript off the list stays exactly as it
       * was — long, but complete and reachable, which a hidden menu behind a
       * dead button would not be.
       */
      .nav-toggle {
        display: inline-flex;
        align-items: center;
        gap: var(--space-3);
        padding: var(--space-3) var(--space-4);
        border: 2px solid var(--color-primary);
        border-radius: var(--radius-sm);
        background: transparent;
        color: var(--color-primary-ink);
        font-family: var(--font-body);
        font-size: 0.9375rem;
        font-weight: 500;
        letter-spacing: 1px;
        text-transform: uppercase;
        cursor: pointer;
      }
      /* Three bars, drawn rather than shipped as an icon file. */
      .nav-toggle__bars,
      .nav-toggle__bars::before,
      .nav-toggle__bars::after {
        display: block;
        width: 1.25rem;
        height: 2px;
        background: currentColor;
      }
      .nav-toggle__bars {
        position: relative;
      }
      .nav-toggle__bars::before,
      .nav-toggle__bars::after {
        content: '';
        position: absolute;
        left: 0;
      }
      .nav-toggle__bars::before {
        top: -6px;
      }
      .nav-toggle__bars::after {
        top: 6px;
      }

      @media (min-width: 800px) {
        /* Never on a wide screen, even once the script has run. */
        .nav-toggle {
          display: none;
        }
      }

      @media (max-width: 799.98px) {
        .site-header[data-nav] nav {
          flex-basis: 100%;
        }
        .site-header[data-nav='closed'] nav {
          display: none;
        }
        .site-header[data-nav] nav ul {
          flex-direction: column;
          gap: var(--space-4);
          padding-block: var(--space-5);
        }
      }

      .site-footer {
        padding-block: var(--space-12);
        background: var(--color-primary);
        color: var(--on-colour);
      }
      .footer-inner {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-8);
        align-items: center;
        justify-content: space-between;
      }
      .footer-logo {
        width: 180px;
        height: auto;
      }
      .footer-right {
        margin-left: auto;
        text-align: right;
      }
      .site-footer p {
        margin: 0;
      }
      .site-footer a {
        color: var(--on-colour);
      }
      .footer-links {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: var(--space-2) var(--space-5);
        list-style: none;
        margin: 0 0 var(--space-3);
        padding: 0;
      }
      .footer-links--social {
        font-size: var(--text-sm);
      }
      /* Full white, not `--on-colour-muted`. The teal tops out at 4.64:1
         against pure white, so any transparency at all drops this line below
         4.5:1 — it measured 4.1:1. On this band, "quieter" has to be size. */
      .muted {
        color: var(--on-colour);
        font-size: var(--text-sm);
      }

      @media (max-width: 799.98px) {
        .footer-inner,
        .footer-right {
          text-align: left;
        }
        .footer-links {
          justify-content: flex-start;
        }
      }
    </style>

    <script>
      /**
       * Collapse the navigation on a narrow screen.
       *
       * Progressive enhancement in the literal sense: the markup ships a
       * complete nav and a hidden button, and this is what turns the pair into
       * a menu. Nothing here *reveals* content — with the script absent the
       * list is simply already open, which is why the no-JavaScript browser
       * test still finds every nav link.
       */
      const header = document.querySelector<HTMLElement>('.site-header');
      const toggle = document.querySelector<HTMLButtonElement>('.js-nav-toggle');
      const nav = header?.querySelector('nav');

      if (header && toggle && nav) {
        // Matches the 800px layout breakpoint in tokens.css. CSS cannot read a
        // custom property inside a media query and neither can this, so the
        // number is written in both places and noted in both.
        const narrow = window.matchMedia('(max-width: 799.98px)');

        const setOpen = (open: boolean) => {
          header.dataset.nav = open ? 'open' : 'closed';
          toggle.setAttribute('aria-expanded', String(open));
        };

        const sync = () => {
          if (narrow.matches) {
            toggle.hidden = false;
            // Collapsed on arrival. Re-reading the current state rather than
            // forcing it shut means rotating a phone does not close a menu
            // somebody just opened.
            if (!header.dataset.nav) setOpen(false);
          } else {
            toggle.hidden = true;
            // Leave no state behind: on a wide screen the CSS above must be
            // the only thing deciding, or a resize can strand the nav hidden.
            delete header.dataset.nav;
            toggle.setAttribute('aria-expanded', 'false');
          }
        };

        toggle.addEventListener('click', () => setOpen(header.dataset.nav !== 'open'));

        // Escape closes it and returns the focus to the button that opened it,
        // which is where a keyboard user expects to be.
        header.addEventListener('keydown', (event) => {
          if (event.key !== 'Escape' || header.dataset.nav !== 'open') return;
          setOpen(false);
          toggle.focus();
        });

        narrow.addEventListener('change', sync);
        sync();
      }
    </script>
  </body>
</html>
