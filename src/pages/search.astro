---
/**
 * Search, via Pagefind.
 *
 * **Pagefind indexes the built HTML**, which is the whole reason it was chosen:
 * there is no second copy of the content to keep in step with Notion, and a
 * page is findable because it exists rather than because something remembered
 * to index it. The consequence is that `astro dev` has no index at all — this
 * page will say it is unavailable there, and that is correct rather than broken.
 * Run `npm run build && npm run preview` to try it.
 *
 * `noindex`, and excluded from the sitemap, because an empty results page is
 * the last thing worth offering someone as a search result. The two are checked
 * against each other by a test.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Search';
const description = 'Search the talks, the workshops and the writing on this site.';
---

<BaseLayout title={title} description={description} suffix noindex>
  <div class="wrap search-page">
    <h1>Search</h1>

    {/* An absolute path, so the bundler treats it as a public asset and leaves
        it alone: like the script below, this file is written by the Pagefind
        CLI *after* the build. A 404 here under `astro dev` is expected and
        costs nothing — the page says so. */}
    <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />

    {/* Pagefind's own UI replaces this. Until it loads — or if it never does —
        the reader gets a working link rather than a dead box. */}
    <div id="search" class="js-search" data-test="search">
      <noscript>
        <p>
          Search needs JavaScript. Everything is reachable without it from{' '}
          <a href="/blog/">the blog</a>, <a href="/talks/">the talks</a> and{' '}
          <a href="/training/">the workshops</a>.
        </p>
      </noscript>
    </div>
  </div>

  <style>
    .search-page {
      padding-block: var(--space-10) var(--space-16);
      max-width: var(--content-width);
    }
    /* Pagefind ships its own stylesheet and exposes these custom properties as
       its only supported theming surface. Setting anything else here would be
       styling somebody else's internal markup. */
    #search {
      --pagefind-ui-primary: var(--color-primary-ink);
      --pagefind-ui-text: var(--color-text);
      --pagefind-ui-background: var(--color-bg);
      --pagefind-ui-border: var(--color-border);
      --pagefind-ui-tag: var(--color-surface);
      --pagefind-ui-border-width: 1px;
      --pagefind-ui-border-radius: var(--radius);
      --pagefind-ui-font: var(--font-body);
    }
  </style>

  <script>
    /**
     * Loaded at runtime rather than imported, because `/pagefind/` does not
     * exist until after `astro build` has finished — it is written by the
     * Pagefind CLI over the top of `dist/`. A bundler asked to resolve it at
     * build time fails, every time, on a file that is about to exist.
     */
    const mount = document.querySelector('#search');

    if (mount) {
      try {
        const { PagefindUI } = await import(
          /* @vite-ignore */ `${import.meta.env.BASE_URL}pagefind/pagefind-ui.js`
        );
        new PagefindUI({ element: '#search', showSubResults: true, showImages: false });
      } catch {
        mount.innerHTML =
          '<p>Search is not available on this build. It is generated by ' +
          '<code>npm run build</code>, so a development server never has it.</p>';
      }
    }
  </script>
</BaseLayout>
