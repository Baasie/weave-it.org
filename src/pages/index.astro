---
/**
 * The home page.
 *
 * A holding page, deliberately. It exists so the build, the deploy, the URL
 * contract and the tests are provable end to end before any content has moved —
 * see MIGRATION.md phase 1. Replace it once the brand and the content model are
 * settled; do not grow it in the meantime.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../../site.config.ts';
---

<BaseLayout title={site.title} description={site.description}>
  <div class="wrap prose hero">
    <h1>{site.tagline}</h1>
    <p class="lead">{site.description}</p>

    <ul class="sections">
      {
        site.sections
          .filter((s) => s.inNav)
          .map((s) => (
            <li>
              <a href={`/${s.path}/`}>{s.label}</a>
            </li>
          ))
      }
    </ul>
  </div>

  <style>
    .hero {
      padding-block: var(--space-16);
    }
    .lead {
      font-size: var(--text-lg);
      color: var(--color-text-muted);
    }
    .sections {
      list-style: none;
      padding: 0;
      margin-top: var(--space-8);
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-4);
    }
    .sections a {
      display: inline-block;
      padding: var(--space-3) var(--space-5);
      background: var(--color-primary-soft);
      color: var(--on-brand);
      border-radius: var(--radius);
      text-decoration: none;
    }
  </style>
</BaseLayout>
